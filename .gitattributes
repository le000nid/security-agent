* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.ico binary

# runtime artifacts and caches never ship in release archives (git archive)
runs/ export-ignore
logs/ export-ignore
reports/ export-ignore
.pytest_cache/ export-ignore
.ruff_cache/ export-ignore
__pycache__/ export-ignore
