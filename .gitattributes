* text=auto
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.ico binary
Dockerfile text eol=lf

# Release archives contain reviewed source only, never local/runtime state.
.git export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.env export-ignore
.env.* export-ignore
.env.example -export-ignore
runs export-ignore
logs export-ignore
reports export-ignore
__pycache__ export-ignore
**/__pycache__ export-ignore
.pytest_cache export-ignore
.ruff_cache export-ignore
.venv export-ignore
.validation export-ignore
dist export-ignore
build export-ignore
*.egg-info export-ignore
*.zip export-ignore
