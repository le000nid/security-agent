LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://deepcode.ci.nsu.ru/api
LLM_MODEL=auto
LLM_MODEL_POLICY=fast
LLM_API_KEY=replace_me
AGENT_MAX_STEPS=8
AGENT_MAX_PLANNER_CALLS=8
LLM_PLANNER_MAX_TOKENS=320
LLM_PLANNER_RETRY_MAX_TOKENS=512
LLM_ENRICHMENT_BATCH_SIZE=1
LLM_ENRICHMENT_MAX_TOKENS=1800
LLM_ENRICHMENT_RETRY_MAX_TOKENS=3200
LLM_BRIEF_ENABLED=true
LLM_BRIEF_MAX_TOKENS=6000
LLM_BRIEF_RETRY_MAX_TOKENS=10000
# Chat Analyst only: one completeness retry, each 256-32768, retry > initial.
LLM_CHAT_MAX_TOKENS=6000
LLM_CHAT_RETRY_MAX_TOKENS=10000
LLM_REPORT_TONE=funny
LLM_REPORT_LANGUAGE=ru
# Optional prebuilt image (otherwise bootstrap builds locally):
# AGENT_IMAGE=ghcr.io/OWNER/REPOSITORY:0.4.1
